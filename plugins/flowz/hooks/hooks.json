{
  "description": "FlowZ session routing and toggle hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/flowz_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\flowz_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/flowz_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\flowz_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/flowz_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\flowz_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/flowz_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\flowz_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
